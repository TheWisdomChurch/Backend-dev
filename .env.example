# Core
ENVIRONMENT=development
LOG_LEVEL=info
APP_NAME=Wisdom House Backend
APP_VERSION=1.0.0
APP_DEBUG=false
APP_PUBLIC_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
APP_LOGO_URL=
APP_PASTOR_NAME=
APP_SUPPORT_EMAIL=
APP_ADMIN_PORTAL_URL=
APP_FORM_CLEANUP_INTERVAL=1h
APP_EMAIL_TEMPLATE_ASSET_BASE_URL=

# Feature flags
# Set to true to bypass OTP and/or disable outbound email (temporary emergency switch).
DISABLE_OTP=false
DISABLE_LOGIN_OTP=false
DISABLE_EMAIL=false

# CORS
# Comma-separated list of allowed origins. Required in production if APP_*_URL not set.
CORS_ALLOW_ORIGIN=
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true
CORS_EXPOSED_HEADERS=Content-Length,Content-Range,X-Total-Count
CORS_MAX_AGE=86400

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=OgbaPeter@96
DATABASE_DBNAME=wisdom_church_db
DATABASE_SSLMODE=disable
DATABASE_MAX_IDLE_CONNS=10
DATABASE_MAX_OPEN_CONNS=100
DATABASE_CONN_MAX_LIFETIME=1h

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=5m

# Auth / JWT
JWT_SECRET=change_me
JWT_EXPIRATION=24h

# SMTP (primary: Postfix/local relay or direct SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=true

# Alternative SMTP envs (optional; recommended for Postfix/local relay)
APP_SMTP_HOST=
APP_SMTP_PORT=25
APP_SMTP_USER=
APP_SMTP_PASS=
APP_SMTP_FROM_EMAIL=
APP_SMTP_FROM_NAME=
APP_SMTP_TIMEOUT_SECONDS=10
APP_SMTP_TLS=false

# Brevo (Transactional Email fallback)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
# BREVO_BASE_URL=https://api.brevo.com

# DigitalOcean Spaces (Storage)
SPACES_BUCKET=
SPACES_REGION=
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
# SPACES_PUBLIC_BASE_URL=https://your-bucket.nyc3.digitaloceanspaces.com
SPACES_BASE_PATH=
SPACES_PUBLIC_READ=true
SPACES_EMAIL_TEMPLATE_PATH=email_template

# Birthday scheduler
BIRTHDAY_SCHEDULER_ENABLED=false
BIRTHDAY_SCHEDULER_ONLY=false
BIRTHDAY_SCHEDULER_TIME=09:00
BIRTHDAY_SCHEDULER_TZ=UTC

# AWS SES (disabled)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# SES_FROM_EMAIL=

# BunnyCDN (disabled)
# BUNNYCDN_STORAGE_ZONE=
# BUNNYCDN_STORAGE_KEY=
# BUNNYCDN_STORAGE_REGION=
# BUNNYCDN_PULL_ZONE=
# BUNNYCDN_BASE_PATH=
