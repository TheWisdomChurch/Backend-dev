# Core
ENVIRONMENT=development
LOG_LEVEL=info
SERVER_PORT=8080
SERVER_GIN_MODE=debug
APP_NAME=Wisdom House Backend
APP_VERSION=1.0.0
APP_DEBUG=false
APP_PUBLIC_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
APP_LOGO_URL=
APP_PASTOR_NAME=
APP_SUPPORT_EMAIL=
APP_ADMIN_PORTAL_URL=
APP_FORM_CLEANUP_INTERVAL=1h
APP_EMAIL_TEMPLATE_ASSET_BASE_URL=

# Feature flags
# Set to true to bypass OTP and/or disable outbound email (temporary emergency switch).
DISABLE_OTP=false
DISABLE_LOGIN_OTP=false
DISABLE_EMAIL=false

# CORS
# Comma-separated list of allowed origins. Required in production if APP_*_URL not set.
CORS_ALLOW_ORIGIN=
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,X-CSRF-Token,X-Request-ID
CORS_ALLOW_CREDENTIALS=true
CORS_EXPOSED_HEADERS=Content-Length,Content-Range,X-Total-Count,X-CSRF-Token,X-Request-ID
CORS_MAX_AGE=86400

# Database
DATABASE_URL=
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
DATABASE_DBNAME=wisdom_church_db
DATABASE_SSLMODE=disable
DATABASE_MAX_IDLE_CONNS=10
DATABASE_MAX_OPEN_CONNS=100
DATABASE_CONN_MAX_LIFETIME=1h
RUN_AUTOMIGRATE=false

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=5m

# Rate limiting
RATE_LIMIT_GLOBAL_RPM=300
RATE_LIMIT_GLOBAL_BURST=100
RATE_LIMIT_GLOBAL_WINDOW=1m
RATE_LIMIT_AUTH_RPM=20
RATE_LIMIT_AUTH_BURST=10
RATE_LIMIT_AUTH_WINDOW=1m

# Auth / JWT
JWT_SECRET=change_me
JWT_EXPIRATION=24h
AUTH_SESSION_IDLE_TIMEOUT=30m
AUTH_REMEMBERED_SESSION_IDLE_TIMEOUT=720h
AUTH_REMEMBER_ME_TTL=720h
AUTH_CSRF_COOKIE_TTL=12h
AUTH_CSRF_COOKIE_NAME=csrf_secret
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_characters
AUTH_MFA_ISSUER=Wisdom Church Admin

# SMTP (primary: Postfix/local relay or direct SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional alias used by some providers/platforms
SMTP_PASSWORD=
SMTP_FROM=
# Optional split sender aliases
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_TLS=true

# Alternative SMTP envs (optional; recommended for Postfix/local relay)
APP_SMTP_HOST=
APP_SMTP_PORT=25
APP_SMTP_USER=
APP_SMTP_PASS=
# Optional alias
APP_SMTP_PASSWORD=
APP_SMTP_FROM_EMAIL=
APP_SMTP_FROM_NAME=
APP_SMTP_TIMEOUT_SECONDS=10
APP_SMTP_TLS=false

# Generic mail aliases (supported)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_TLS=

# Brevo (Transactional Email fallback)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
# BREVO_BASE_URL=https://api.brevo.com

# S3-compatible object storage (Supabase S3, MinIO, etc.)
S3_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
S3_BASE_PATH=
S3_PUBLIC_READ=true
S3_EMAIL_TEMPLATE_PATH=email_template

# Birthday scheduler
BIRTHDAY_SCHEDULER_ENABLED=false
BIRTHDAY_SCHEDULER_ONLY=false
BIRTHDAY_SCHEDULER_TIME=09:00
BIRTHDAY_SCHEDULER_TZ=UTC

# AWS SES (disabled)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# SES_FROM_EMAIL=
