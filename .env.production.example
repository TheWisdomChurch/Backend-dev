# Production Environment Configuration Template
# Copy to .env.production and fill in real values. .env.production itself is gitignored
# and must never be committed.
ENVIRONMENT=production
LOG_LEVEL=warn
SERVER_PORT=8080
SERVER_GIN_MODE=release
# Trust only reverse proxies that actually connect to the API. These are
# Cloudflare's published IPv4/IPv6 ranges. If the frontend reaches the API
# through another private proxy, append that proxy's exact IP/CIDR as well.
SERVER_TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
APP_NAME=Wisdom House Backend
APP_VERSION=1.0.0
APP_DEBUG=false

# Public browsing generates several API reads per page. Keep these explicit in
# production rather than relying on defaults that operators cannot audit.
RATE_LIMIT_GLOBAL_RPM=300
RATE_LIMIT_GLOBAL_BURST=100
RATE_LIMIT_GLOBAL_WINDOW=1m

# Database (use managed PostgreSQL in production)
DATABASE_URL=postgres://user:password@prod-host:5432/wisdom_house?sslmode=require

# Redis (use managed Redis in production)
REDIS_URL=redis://prod-redis-host:6379/0

# URLs
APP_PUBLIC_URL=https://api.wisdomchurchhq.org
APP_FRONTEND_URL=https://wisdomchurchhq.org
APP_ADMIN_PORTAL_URL=https://admin.wisdomchurchhq.org

# CORS
CORS_ALLOW_ORIGIN=https://wisdomchurchhq.org,https://www.wisdomchurchhq.org,https://admin.wisdomchurchhq.org
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,X-CSRF-Token,X-Request-ID
CORS_ALLOW_CREDENTIALS=true

# Authentication & Security
# Both secrets must be at least 32 characters — generate with e.g. `openssl rand -base64 32`.
AUTH_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_TO_A_RANDOM_32_CHAR_SECRET
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_TO_A_DIFFERENT_RANDOM_32_CHAR_SECRET

# Feature flags
DISABLE_OTP=false
DISABLE_LOGIN_OTP=false
DISABLE_EMAIL=false

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@wisdomchurchhq.org
SMTP_PASSWORD=CHANGE_ME_IN_PRODUCTION
SMTP_FROM=Wisdom House <noreply@wisdomchurchhq.org>
SMTP_TLS=true
# Traffic-aware church navigation
NAVIGATION_ENABLED=true
GOOGLE_MAPS_ROUTES_API_KEY=
GOOGLE_CHURCH_PLACE_ID=
NAVIGATION_PROVIDER_TIMEOUT=12s
NAVIGATION_RATE_LIMIT_RPM=10
NAVIGATION_RATE_LIMIT_BURST=3
