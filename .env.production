# Production Environment Configuration
ENVIRONMENT=production
LOG_LEVEL=warn
SERVER_PORT=8080
SERVER_GIN_MODE=release
APP_NAME=Wisdom House Backend
APP_VERSION=1.0.0
APP_DEBUG=false

# Database (use managed PostgreSQL in production)
DATABASE_URL=postgres://user:password@prod-host:5432/wisdom_house?sslmode=require

# Redis (use managed Redis in production)
REDIS_URL=redis://prod-redis-host:6379/0

# URLs
APP_PUBLIC_URL=https://api.wisdomchurchhq.org
APP_FRONTEND_URL=https://wisdomchurchhq.org
APP_ADMIN_PORTAL_URL=https://admin.wisdomchurchhq.org

# CORS
CORS_ALLOW_ORIGIN=https://wisdomchurchhq.org,https://www.wisdomchurchhq.org,https://admin.wisdomchurchhq.org
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,X-CSRF-Token,X-Request-ID
CORS_ALLOW_CREDENTIALS=true

# Authentication & Security
AUTH_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
AUTH_ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# Feature flags
DISABLE_OTP=false
DISABLE_LOGIN_OTP=false
DISABLE_EMAIL=false

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@wisdomchurchhq.org
SMTP_PASSWORD=CHANGE_ME_IN_PRODUCTION
SMTP_FROM=Wisdom House <noreply@wisdomchurchhq.org>
SMTP_TLS=true
