          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "const headers = pm.response.headers.all().filter(h => h.key && h.key.toLowerCase() === 'set-cookie');",
                  "if (headers.length) {",
                  "  const pairs = headers.map(h => h.value.split(';')[0]);",
                  "  pm.collectionVariables.set('authCookie', pairs.join('; '));",
                  "}",
                  "const user = (json && json.data && (json.data.user || json.data)) || {};",
                  "const userId = user.id || json.id;",
                  "if (userId) pm.collectionVariables.set('userId', userId);"
                ]
              }
            }
          ]
